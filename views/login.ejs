<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/css/login.css">
<title>911 Portal </title>
</head>
<body>
  <!-- LEFT -->
  <div class="left">
    <div class="top-left">911 Scaling</div>
    <div class="starburst">
      <span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span>
    </div>
    <div class="bottom-left"> 911 Portal 2026. All rights reserved.</div>
    <div id="particles"></div>
  </div>

  <!-- RIGHT -->
  <div class="right">
    <div class="form-content">
      <h1>Login</h1>
      <div class="fields">
        <div class="field">
          <label>Email</label>
          <input type="email">
          <hr></hr>
        </div>
        <div class="field">
          <label>Password</label>
          <div class="pass-wrap">
            <input type="password">
            <span class="eye"></span>
           <hr></hr>
          </div>
        </div>
      </div>
    </div>
    <button class="sign-in">Login</button>


  </div>
<script src="/js/server.js"></script>
<script src="/js/login.js"></script>
</body>
</html>
